{
  "redirects": [
    {
      "source": "/api/link",
      "has": [{ "type": "query", "key": "t", "value": "(?<t>[\\w-]{1,64})" }],
      "missing": [{ "type": "header", "key": "user-agent", "value": ".*([Bb]ot|facebookexternalhit|Facebot|meta-externalagent|Zalo|WhatsApp|Slack|Discord|Telegram|SkypeUriPreview|Embedly|[Cc]rawler|[Ss]pider|[Pp]review).*" }],
      "destination": "/features/quiz/link.html?t=:t",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/__/auth/:path*", "destination": "https://zitthenkne.firebaseapp.com/__/auth/:path*" }
  ]
}
