rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // USERS
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      match /achievements/{achievementId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // QUIZ SETS (THƯ VIỆN ĐỀ)
    match /quiz_sets/{setId} {
      allow read: if resource.data.isPublic == true
                  || (request.auth != null && request.auth.uid == resource.data.userId);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // QUIZ FOLDERS (THƯ MỤC ĐỀ TRẮC NGHIỆM)
    match /quiz_folders/{folderId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // QUIZ RESULTS
    match /quiz_results/{resultId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // QUIZ STUDY DATA (GHI CHÚ / ĐÁNH DẤU / BÔI VÀNG CỦA NGƯỜI HỌC)
    match /quiz_study/{docId} {
      allow read, update, delete: if request.auth != null
                                  && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.userId;
    }

    // STUDY ROOMS
    match /study_rooms/{roomId} {
      allow read, create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;

      match /drawings/{drawingId} {
        allow read, create, update: if request.auth != null;
        allow delete: if request.auth != null && get(/databases/$(database)/documents/study_rooms/$(roomId)).data.owner == request.auth.uid;
      }
      match /members/{memberId} {
        allow read, create, update, delete: if request.auth != null;
      }
      match /messages/{messageId} {
        allow read, create: if request.auth != null;
      }
      match /progress/{progressId} {
        allow read, create, update: if request.auth != null;
        allow delete: if request.auth != null && get(/databases/$(database)/documents/study_rooms/$(roomId)).data.owner == request.auth.uid;
      }
      match /quizSession/{sessionId} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null;
        allow delete: if request.auth != null && resource.data.hostId == request.auth.uid;
      }
    }

    // QUIZZES (nếu còn dùng)
    match /quizzes/{quizId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow update, delete: if request.auth != null && resource.data.createdBy == request.auth.uid;
    }

    // ===== KHO LƯU TRỮ LINK (công khai cho ai có mật khẩu giao diện) =====
    match /shared_links/{linkId} {
      allow read, write: if true;
    }
    match /shared_link_folders/{folderId} {
      allow read, write: if true;
    }

  }
}
