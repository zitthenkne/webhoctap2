rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Hàm dùng chung (2026-10-09, vòng /loop "Firebase chặt chẽ hơn") ----
    // isOwner: đã đăng nhập và đúng chủ của tài liệu.
    // keepsOwner: sửa tài liệu KHÔNG được đổi trường userId (trước đây chủ bộ có thể "tặng" bộ/thư mục/ghi chú cho người khác = gài rác vào thư viện của họ).
    function isOwner(uid) { return request.auth != null && request.auth.uid == uid; }
    function keepsOwner() { return request.resource.data.userId == resource.data.userId; }
    // CHIA SẺ RIÊNG (2026-10-27): bộ đề / thư mục có `sharedWith` = danh sách email (chữ thường) được xem. Chỉ tin email ĐÃ XÁC NHẬN —
    // không thì ai cũng tạo tài khoản bằng email của người được mời rồi đọc ké. Email trong token Firebase luôn là chữ thường.
    // Viết thẳng `resource.data.sharedWith` (không .get mặc định) để Firestore chứng minh được truy vấn `sharedWith array-contains <email>`
    // của trang "Được chia sẻ với tôi"; doc thiếu trường → vế này lỗi = không cho, đúng ý.
    function sharedWithMe() {
      return request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.token.email in resource.data.sharedWith
          && trustedSession();
    }
    // PHIÊN TIN CẬY (chống cho mượn tài khoản, 2026-10-28): đăng nhập bằng GOOGLE và phiên này (auth_time — mốc đăng nhập, mỗi máy một mốc,
    // không giả được) nằm trong danh sách máy hợp lệ users/{uid}/private/devices.authTimes. Danh sách do MÁY CHỦ ghi (api/devices.js, tối đa
    // 2 máy, admin/ngoại lệ 20) — app không ghi được. Máy bị đẩy ra → không đọc được đề chia sẻ nữa dù có sửa code. Chỉ áp cho đề NGƯỜI KHÁC
    // chia sẻ (1 lượt đọc thêm); dữ liệu của chính mình và đề công khai không cần.
    function isExempt() {
      let cfg = get(/databases/$(database)/documents/config/access).data;
      return isAdmin()
          || (request.auth != null
              && request.auth.token.email_verified == true
              && (request.auth.token.email in cfg.get('deviceExempt', [])
                  || request.auth.token.email in cfg.get('passwordAllowed', [])));
    }
    function trustedSession() {
      return isAdmin()
          || ((request.auth.token.firebase.sign_in_provider == 'google.com' || isExempt())
              && request.auth.token.auth_time
                   in get(/databases/$(database)/documents/users/$(request.auth.uid)/private/devices).data.get('authTimes', []));
    }
    // TÀI KHOẢN ĐÃ DUYỆT (2026-10-29): tạo tài khoản phải nhập ĐÚNG mật khẩu web — máy chủ (api/signup.js) kiểm rồi gắn custom claim
    // `approved` vào token (không giả được, không tốn lượt đọc). Tài khoản có từ trước được duyệt tự động (api/devices.js). Chưa duyệt
    // → đăng nhập được nhưng KHÔNG tạo được bộ đề / thư mục / ảnh / bệnh án / phòng (lách ô mật khẩu web bằng DevTools cũng vô ích).
    // uid admin: khớp isAdminToken trong api/_lib/admin.js — skill up-cau-hoi (upload.py) đăng nhập mật khẩu, email có thể chưa xác nhận.
    function approved() {
      return request.auth != null
          && (request.auth.token.get('approved', false) == true || isAdmin() || request.auth.uid == 'qZ5dzmJzrjdpN9l4n9x5UGPwHE43');
    }
    // LINK CÔNG KHAI CÓ HẠN: isPublic + publicUntil (mặc định 12 giờ; thiếu/null = không hết hạn — link cũ). So với giờ MÁY CHỦ.
    function publicAlive() {
      return resource.data.get('isPublic', false) == true
          && (resource.data.get('publicUntil', null) == null || request.time < resource.data.publicUntil);
    }
    // Người được chia sẻ tự "Rời chia sẻ" (folder.js ?shared=me): chỉ được sửa sharedWith/editors, và chỉ để GỠ ĐÚNG email của mình.
    function leavesShare() {
      let me = [request.auth.token.email].toSet();
      return sharedWithMe()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sharedWith', 'editors'])
          && request.resource.data.sharedWith.toSet() == resource.data.sharedWith.toSet().difference(me)
          && request.resource.data.get('editors', []).toSet() == resource.data.get('editors', []).toSet().difference(me);
    }
    // VAI TRÒ "NGƯỜI CHỈNH SỬA" (giống Google Drive): `editors` = các email trong sharedWith được sửa NỘI DUNG bộ đề
    // (câu hỏi, tên, mô tả) — không đổi được quyền chia sẻ, công khai, chủ sở hữu, thư mục hay xóa.
    function editsAsEditor() {
      return request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.token.email in resource.data.get('editors', [])
          && request.auth.token.email in resource.data.get('sharedWith', [])
          && trustedSession()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['questions', 'questionCount', 'title', 'description', 'updatedAt']);
    }
    // Danh sách chia sẻ: mảng ≤ 50 người; editors phải nằm trong sharedWith; sharedBy (tên người chia sẻ) chuỗi ≤ 100; allowTakeout (chủ cho
    // người khác MANG ĐỀ ĐI: lưu bản sao, mở phòng "Làm cùng nhau", lưu đề từ phòng — mặc định không) là bool. Chặn ghi rác làm phình doc.
    function validShare(d) {
      return d.get('sharedWith', []) is list && d.get('sharedWith', []).size() <= 50
          && d.get('editors', []) is list && d.get('sharedWith', []).hasAll(d.get('editors', []))
          && d.get('sharedBy', '') is string && d.get('sharedBy', '').size() <= 100
          && d.get('allowTakeout', false) is bool
          && (d.get('publicUntil', null) == null || d.publicUntil is timestamp);
    }
    // BẢN SAO (Lưu bản sao / Lưu đề từ phòng / Nhân bản): app luôn ghi `copiedFrom` = id bộ đề gốc. Gốc đã khóa (không allowTakeout)
    // thì chỉ CHỦ gốc được chép. Gốc đã bị xóa → cho (không còn gì để bảo vệ). Tốn 1 lượt đọc, và chỉ khi tạo bản sao.
    function copyAllowed(d) {
      let src = d.get('copiedFrom', null);
      return src == null
          || !exists(/databases/$(database)/documents/quiz_sets/$(src))
          || get(/databases/$(database)/documents/quiz_sets/$(src)).data.userId == request.auth.uid
          || get(/databases/$(database)/documents/quiz_sets/$(src)).data.get('allowTakeout', false) == true;
    }

    // ADMIN — tài khoản quản trị của chủ web (email đã xác nhận; đăng nhập Google luôn đã xác nhận). Thêm admin: thêm email vào đây
    // VÀ vào ADMIN_EMAILS trong core/device-limit.js.
    function isAdmin() {
      return request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.token.email in ['vietthanhne@gmail.com'];
    }

    // CONFIG — cấu hình chung do admin chỉnh (vd config/access.deviceExempt = email được dùng KHÔNG giới hạn số máy;
    // config/access.defaultLimit = số máy mặc định; config/announce = thông báo admin gửi — core/announce.js).
    // Người đăng nhập đọc được (app cần biết mình có được ngoại lệ không); chỉ admin ghi.
    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin()
                   && (docId != 'access' || (request.resource.data.get('deviceExempt', []) is list
                                             && request.resource.data.get('deviceExempt', []).size() <= 500
                                             && request.resource.data.get('passwordAllowed', []) is list
                                             && request.resource.data.get('passwordAllowed', []).size() <= 500
                                             && request.resource.data.get('defaultLimit', 2) is int
                                             && request.resource.data.get('defaultLimit', 2) >= 1
                                             && request.resource.data.get('defaultLimit', 2) <= 20));
    }

    // LƯỢT LÀM ĐỀ — core/quiz-run.js ghi lúc bắt đầu và lúc nộp; trang Quản trị đọc (báo cáo + cảnh báo 2 máy).
    // Mỗi tài khoản × mỗi máy một doc `{uid}_{deviceId}`. Chủ tài khoản đọc được doc của MÌNH (máy này biết máy kia đang làm đề → cảnh báo);
    // chỉ ghi được doc mang uid + máy của mình, `at` = giờ máy chủ (không giả giờ được).
    function validRun(d) {
      return d.keys().hasOnly(['uid', 'email', 'name', 'device', 'label', 'quizId', 'title', 'mode', 'state', 'startedAt', 'pct', 'at', 'expireAt'])
          && d.uid == request.auth.uid
          && d.at == request.time
          && d.device is string && d.device.matches('[A-Za-z0-9]{4,40}')
          && d.state in ['doing', 'done']
          && d.get('name', '') is string && d.get('name', '').size() <= 80
          && d.get('label', '') is string && d.get('label', '').size() <= 80
          && d.get('quizId', '') is string && d.get('quizId', '').size() <= 120
          && d.get('title', '') is string && d.get('title', '').size() <= 200
          && d.get('mode', '') is string && d.get('mode', '').size() <= 20
          && d.get('startedAt', 0) is int && d.get('pct', 0) is int
          && d.get('email', '').lower() == request.auth.token.get('email', '').lower();
    }
    // NHẬT KÝ QUẢN TRỊ — máy chủ (api/devices.js) ghi mọi thao tác admin với tài khoản; trang Quản trị tự ghi thao tác cài đặt
    // (số máy mặc định, thông báo). Chỉ admin đọc / thêm; không ai sửa hay xoá được (kể cả admin) → không xoá dấu vết.
    match /admin_log/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin()
                    && request.resource.data.keys().hasOnly(['at', 'by', 'action', 'target', 'detail'])
                    && request.resource.data.at == request.time
                    && request.resource.data.by == request.auth.token.email;
      allow update, delete: if false;
    }

    match /quiz_runs/{docId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create, update: if request.auth != null
                            && validRun(request.resource.data)
                            && docId == request.auth.uid + '_' + request.resource.data.device;
      allow delete: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
    }

    // USERNAMES — bảng tra cho ô đăng nhập gõ TÊN (core/usernames.js): usernames/{khóa tên} = { uid, email }.
    // Khách chưa đăng nhập cần tra tên → email, nhưng users/{uid} không được mở (lộ email mọi người) → bảng riêng:
    // get công khai (phải biết đúng tên), KHÔNG liệt kê; mỗi tên thuộc người giữ nó trước, chỉ ghi được email của chính token.
    match /usernames/{nameKey} {
      function validName() {
        return request.resource.data.keys().hasOnly(['uid', 'email'])
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.email == request.auth.token.email;
      }
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null && validName();
      allow update: if request.auth != null && resource.data.uid == request.auth.uid && validName();
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // USERS
    // users/{uid}.email là chỗ ADMIN tra cứu tài khoản theo email (core/device-limit.js findAccount) → không ai được ghi email KHÁC email
    // đăng nhập của chính mình vào đây (giả làm người khác). Doc cũ có email sẵn thì sửa trường khác vẫn được (email không đổi).
    function ownEmailOk() {
      return request.resource.data.get('email', null) == null
          || request.resource.data.email.lower() == request.auth.token.get('email', '').lower();
    }
    match /users/{userId} {
      allow read: if (request.auth != null && request.auth.uid == userId) || isAdmin();
      allow delete: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId && ownEmailOk();
      allow update: if request.auth != null && request.auth.uid == userId
                    && (request.resource.data.get('email', null) == resource.data.get('email', null) || ownEmailOk());
      match /achievements/{achievementId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      // private/devices (máy đang đăng nhập + authTimes cho trustedSession) và private/logins (lịch sử đăng nhập): CHỈ MÁY CHỦ ghi
      // (api/devices.js, Admin SDK bỏ qua luật). App chỉ đọc: chủ tài khoản và admin.
      match /private/{docId} {
        allow read: if (request.auth != null && request.auth.uid == userId) || isAdmin();
        allow write: if false;
      }
    }

    // QUIZ SETS (THƯ VIỆN ĐỀ)
    // get (mở MỘT bộ đề bằng link): công khai còn hạn / chủ / được chia sẻ. list (truy vấn): chỉ chủ hoặc được chia sẻ — KHÔNG còn liệt kê
    // đề công khai từ app (trước đây ai cũng quét được mọi đề công khai); thư mục công khai lấy danh sách qua máy chủ (api/public.js).
    match /quiz_sets/{setId} {
      allow get: if publicAlive()
                 || (request.auth != null && request.auth.uid == resource.data.userId)
                 || sharedWithMe();
      allow list: if (request.auth != null && request.auth.uid == resource.data.userId)
                  || sharedWithMe();
      allow create: if isOwner(request.resource.data.userId) && approved() && validShare(request.resource.data) && copyAllowed(request.resource.data);
      allow update: if (isOwner(resource.data.userId) && keepsOwner() && validShare(request.resource.data)) || leavesShare() || editsAsEditor();
      allow delete: if isOwner(resource.data.userId);
    }

    // QUIZ FOLDERS (THƯ MỤC ĐỀ TRẮC NGHIỆM)
    match /quiz_folders/{folderId} {
      // isPublic == true: ai có link thư mục cũng xem được danh sách bộ đề bên trong
      // (các bộ đề vẫn tự kiểm tra isPublic của riêng nó ở rule quiz_sets bên trên).
      // sharedWith: chỉ những tài khoản được mời mới xem (bộ đề bên trong được chép cùng danh sách lúc chia sẻ).
      allow get: if publicAlive()
                 || (request.auth != null && request.auth.uid == resource.data.userId)
                 || sharedWithMe();
      allow list: if (request.auth != null && request.auth.uid == resource.data.userId)
                  || sharedWithMe();
      allow create: if isOwner(request.resource.data.userId) && approved() && validShare(request.resource.data);
      allow update: if (isOwner(resource.data.userId) && keepsOwner() && validShare(request.resource.data)) || leavesShare();
      allow delete: if isOwner(resource.data.userId);
    }

    // QUIZ RESULTS
    // Trước đây CHỈ có read + create: app lại XÓA lượt làm (quiz-history: từng dòng + xóa sạch) và SỬA điểm sau khi tự chấm tự luận
    // (quiz-state updateQuizResultScore) -> cả hai bị từ chối, mà hàm queued() nuốt lỗi nên giao diện vẫn báo "đã xóa/đã lưu".
    // Nay: xóa được (chủ); sửa được ĐÚNG 3 trường điểm; tạo phải có điểm hợp lệ (số, 0–100, số câu 0–5000).
    function validScore(d) {
      return d.score is number
          && d.totalQuestions is int && d.totalQuestions >= 0 && d.totalQuestions <= 5000
          && d.percentage is number && d.percentage >= 0 && d.percentage <= 100;
    }
    match /quiz_results/{resultId} {
      // Admin đọc được để xem lịch sử làm đề của một tài khoản (trang Quản trị)
      allow read: if (request.auth != null && request.auth.uid == resource.data.userId) || isAdmin();
      allow create: if isOwner(request.resource.data.userId) && validScore(request.resource.data);
      allow update: if isOwner(resource.data.userId) && keepsOwner()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['score', 'totalQuestions', 'percentage'])
                    && validScore(request.resource.data);
      allow delete: if isOwner(resource.data.userId);
    }

    // QUIZ STUDY DATA (GHI CHÚ / ĐÁNH DẤU / BÔI VÀNG / LỊCH ÔN CỦA NGƯỜI HỌC)
    // id tài liệu BẮT BUỘC = "<uid>__<quizId>" (đúng như studyDocId() trong quiz-study-store.js): trước đây ai cũng tạo được tài liệu
    // mang id của người khác (userId của mình) và chiếm chỗ -> người đó không ghi được ghi chú cho bộ đề ấy nữa.
    // get tách riêng khỏi list: đọc tài liệu CHƯA TỒN TẠI thì `resource` = null -> `resource.data.userId` lỗi -> bị từ chối (403) thay vì "không có".
    // Mỗi lần mở một bộ đề mới app đọc quiz_study/{uid}__{quizId} (chưa có) -> trước đây dính 403 (tính 1 lượt đọc + cảnh báo console, và vì lỗi nên
    // bộ nhớ đệm 15 giây không giữ -> đọc lần hai). Id luôn bắt đầu bằng "<uid>__" nên get kiểm theo id, không cần tài liệu có sẵn.
    // list (truy vấn userId == uid ở chuông ôn tập / thống kê) vẫn kiểm theo trường userId của từng tài liệu.
    match /quiz_study/{docId} {
      allow get: if request.auth != null
                 && (docId.split('__')[0] == request.auth.uid
                     || (resource != null && resource.data.userId == request.auth.uid));
      allow list: if isOwner(resource.data.userId);
      // xóa theo id như get: thùng rác xóa hẳn bộ đề thì xóa luôn quiz_study của bộ (trash.js) — bộ chưa từng ghi chú thì doc không có,
      // kiểm theo resource sẽ bị từ chối → lỗi quyền + toast "ghi lỗi" muộn của offline-write.
      allow delete: if request.auth != null
                    && (docId.split('__')[0] == request.auth.uid
                        || (resource != null && resource.data.userId == request.auth.uid));
      allow update: if isOwner(resource.data.userId) && keepsOwner();
      allow create: if isOwner(request.resource.data.userId)
                    && docId == request.auth.uid + '__' + request.resource.data.quizId;
    }

    // BỆNH ÁN (MEDICAL RECORDS) — riêng tư theo từng người dùng
    match /medical_records/{recordId} {
      allow read, delete: if request.auth != null
                          && request.auth.uid == resource.data.userId;
      allow update: if isOwner(resource.data.userId) && keepsOwner();
      allow create: if request.auth != null && approved()
                    && request.auth.uid == request.resource.data.userId;
    }

    // QUIZ PAYLOADS (Nội dung câu hỏi chi tiết tách riêng để chống tràn giới hạn 1MB doc)
    match /quiz_payloads/{setId} {
      allow get: if publicAlive()
                 || (request.auth != null && request.auth.uid == resource.data.userId)
                 || sharedWithMe();
      allow list: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if isOwner(request.resource.data.userId) && approved();
      allow update: if isOwner(resource.data.userId) && keepsOwner();
      allow delete: if isOwner(resource.data.userId);
    }

    // QUIZ IMAGES — ẢNH BỘ ĐỀ LƯU THẲNG TRONG FIRESTORE (2026-10-09; core/zimg.js, skill up-cau-hoi). Trong câu hỏi: ![mô tả](zimg:<id>).
    // id = 32 ký tự hex đầu của SHA-256 nội dung (cùng ảnh → cùng id). Đọc công khai (id không đoán được, như link ảnh của bộ đề công khai;
    // khách ở phòng học cũng xem được) nhưng KHÔNG liệt kê. Chỉ người đăng nhập tạo được, ảnh ≤ 900 KB, đúng bộ trường, bất biến sau khi tạo.
    match /quiz_images/{imageId} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null && approved()
                    && imageId.matches('^[a-f0-9]{32}$')
                    && request.resource.data.keys().hasOnly(['data', 'mime', 'w', 'h', 'bytes', 'userId', 'createdAt'])
                    && request.resource.data.keys().hasAll(['data', 'mime', 'userId'])
                    && request.resource.data.data is bytes
                    && request.resource.data.data.size() > 0
                    && request.resource.data.data.size() <= 900000
                    && request.resource.data.mime in ['image/webp', 'image/png', 'image/jpeg', 'image/gif']
                    && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // STUDY ROOMS — phòng đánh đề chung.
    // ⚠️ CỐ Ý (chủ dự án dặn 2026-10-13 — người/AI sửa sau ĐỪNG "siết cho chặt" chỗ này): khách CHƯA ĐĂNG NHẬP vào phòng bằng link
    // (mã phòng chỉ chia sẻ trong nhóm) và làm chung được hết — đọc, sửa doc phòng, làm bài, chat, vẽ, hiện diện. Vì vậy get/update
    // của phòng và MỌI subcollection bên dưới KHÔNG được đòi request.auth. Chỉ siết những việc khách không bao giờ làm:
    //   - list: chỉ truy vấn "phòng của tôi" (rooms-hub.js: where owner == uid) — người lạ không quét được danh sách mọi phòng;
    //   - create: người đã đăng nhập tạo phòng của chính mình (rooms-hub.js);
    //   - update: không ai đổi được owner (trước đây ai cũng sửa owner thành mình rồi XÓA phòng của người khác);
    //   - delete: chủ phòng.
    match /study_rooms/{roomId} {
      allow get: if true;
      allow list: if request.auth != null && resource.data.owner == request.auth.uid;
      allow create: if request.auth != null && approved() && request.resource.data.owner == request.auth.uid;
      allow update: if request.resource.data.get('owner', null) == resource.data.get('owner', null);
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;

      match /drawings/{drawingId} {
        allow read, create, update, delete: if true;
      }
      match /members/{memberId} {
        allow read, create, update, delete: if true;
      }
      match /messages/{messageId} {
        // Chặn tin nhắn spam vượt quá 2000 ký tự
        allow read: if true;
        allow create: if request.resource.data.text is string && request.resource.data.text.size() <= 2000;
      }
      match /progress/{progressId} {
        allow read, create, update, delete: if true;
      }
      match /quizSession/{sessionId} {
        allow read, create, update, delete: if true;
      }
    }

    // (Đã GỠ luật /quizzes/{quizId}: không có mã nào dùng bộ sưu tập Firestore này — "quizzes" trong code là kho IndexedDB offline.
    //  Luật cũ cho BẤT KỲ người đăng nhập nào tạo/đọc tài liệu tùy ý ở đó.)

    // ===== KHO LƯU TRỮ LINK (công khai cho ai có mật khẩu giao diện) =====
    match /shared_links/{linkId} {
      allow read: if true;
      allow create, update: if request.resource.data.url is string && request.resource.data.url.size() <= 2048;
      allow delete: if request.auth != null;
    }
    match /shared_link_folders/{folderId} {
      allow read, create, update: if true;
      allow delete: if request.auth != null;
    }

  }
}
