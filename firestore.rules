rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // USERS
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      match /achievements/{achievementId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // QUIZ SETS (THƯ VIỆN ĐỀ)
    match /quiz_sets/{setId} {
      allow read: if resource.data.isPublic == true
                  || (request.auth != null && request.auth.uid == resource.data.userId);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // QUIZ FOLDERS (THƯ MỤC ĐỀ TRẮC NGHIỆM)
    match /quiz_folders/{folderId} {
      // isPublic == true: ai có link thư mục cũng xem được danh sách bộ đề bên trong
      // (các bộ đề vẫn tự kiểm tra isPublic của riêng nó ở rule quiz_sets bên trên).
      allow read: if resource.data.isPublic == true
                  || (request.auth != null && request.auth.uid == resource.data.userId);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // QUIZ RESULTS
    match /quiz_results/{resultId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // QUIZ STUDY DATA (GHI CHÚ / ĐÁNH DẤU / BÔI VÀNG CỦA NGƯỜI HỌC)
    match /quiz_study/{docId} {
      allow read, update, delete: if request.auth != null
                                  && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.userId;
    }

    // BỆNH ÁN (MEDICAL RECORDS) — riêng tư theo từng người dùng
    match /medical_records/{recordId} {
      allow read, update, delete: if request.auth != null
                                  && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.userId;
    }

    // STUDY ROOMS — phòng đánh đề chung.
    // Khách CHƯA đăng nhập vào được bằng link (mã phòng do người tạo đặt, chỉ chia sẻ
    // trong nhóm) — cùng kiểu "ai có link thì vào" như kho link chung ở cuối file.
    // Đánh đổi: ai đoán được mã phòng cũng đọc/ghi được nội dung phòng đó.
    // Nếu bật Anonymous sign-in trên Firebase console thì có thể siết lại thành
    // `request.auth != null` như trước — client vẫn chạy đúng.
    // Xóa phòng vẫn phải là chủ phòng đã đăng nhập.
    match /study_rooms/{roomId} {
      allow read, create, update: if true;
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;

      match /drawings/{drawingId} {
        allow read, create, update, delete: if true;
      }
      match /members/{memberId} {
        allow read, create, update, delete: if true;
      }
      match /messages/{messageId} {
        allow read, create: if true;
      }
      match /progress/{progressId} {
        allow read, create, update, delete: if true;
      }
      match /quizSession/{sessionId} {
        allow read, create, update, delete: if true;
      }
    }

    // QUIZZES (nếu còn dùng)
    match /quizzes/{quizId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow update, delete: if request.auth != null && resource.data.createdBy == request.auth.uid;
    }

    // ===== KHO LƯU TRỮ LINK (công khai cho ai có mật khẩu giao diện) =====
    match /shared_links/{linkId} {
      allow read, write: if true;
    }
    match /shared_link_folders/{folderId} {
      allow read, write: if true;
    }

  }
}
